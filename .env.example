# Copy this file to .env for local dev (npm run dev), and add the same
# key/value pairs in Vercel: Project Settings -> Environment Variables.
# None of this depends on Lovable Cloud — these are plain Supabase + provider
# credentials for your own accounts.

# ---- Supabase (required) ----
# Find these in the Supabase dashboard: Project Settings -> API.
# SUPABASE_URL and VITE_SUPABASE_URL are the same value; the VITE_-prefixed
# copy is what Vite inlines into the browser bundle, the other is read
# server-side (auth middleware, server functions).
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# The anon/publishable key (safe to expose to the browser).
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# The service_role key — server-only, bypasses RLS. NEVER prefix this with
# VITE_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Email notifications (optional — skipped with a console warning if unset) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL="CEMP <notifications@yourdomain.com>"
# Falls back to Vercel's own VERCEL_URL if unset.
SITE_URL=

# ---- NOWPayments (optional — withdrawals/payouts only; deposits are manual, see below) ----
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_ENV=sandbox
NOWPAYMENTS_PAYOUT_CALLBACK_URL=

# ---- Block explorer verification (optional — needed to verify manual crypto
# deposit claims against the real chain; a claim's coin/network stays
# unusable until its key is set, but the rest of the app works without these) ----
# Free key: https://etherscan.io/myapikey (create an account, then generate a
# key). Etherscan's v2 API is unified across chains, so this one key also
# verifies USDT-BEP20 deposits (BSC testnet) — no separate BscScan key needed.
ETHERSCAN_API_KEY=
# Optional — raises Tronscan's public rate limit, not required for light usage.
TRONSCAN_API_KEY=
# Optional — raises BlockCypher's public rate limit, not required for light usage.
BLOCKCYPHER_TOKEN=

# ---- BTCPay Server Lightning Network deposits (optional — the "Deposit BTC
# via Lightning" option on the wallet page stays hidden/erroring until these
# are set; on-chain BTC deposits via the HD wallet system are unaffected).
# This is a fully separate integration from the HD wallet — it never reads
# or writes user_deposit_addresses/master_wallets.
BTCPAY_HOST=https://your-btcpay-instance.example.com
BTCPAY_STORE_ID=your-store-id
# Generate under your BTCPay account: Account -> API Keys -> Generate Key,
# with at least the "View your stores" + "Create/view Lightning invoices"
# permissions for this store. Never commit the real value.
BTCPAY_API_KEY=
# Only needed if you later wire up BTCPay's own "Invoice" webhooks (see
# src/routes/api/public/webhooks/btcpay.tsx for why the current raw-Lightning-
# invoice flow doesn't use this at all — it polls instead). Generate in
# BTCPay: Store Settings -> Webhooks -> Add webhook -> copy the secret it
# shows you.
BTCPAY_WEBHOOK_SECRET=

# Same three BTCPAY_HOST / BTCPAY_STORE_ID / BTCPAY_API_KEY values are also
# needed as Supabase secrets (not just here) for the watch-lightning-deposits
# Edge Function — set via `supabase secrets set BTCPAY_HOST=... BTCPAY_STORE_ID=... BTCPAY_API_KEY=...`.

# ---- Cron shared secret (required once you wire the pg_cron jobs in
# supabase/migrations — protects the derive-address/watch-deposits/sweep
# Edge Functions and the app's own /api/public/cron/expire-trades route from
# being triggered by anyone who finds the URL). Generate any random 32-byte
# hex string and use the SAME value here, as a Supabase secret
# (`supabase secrets set CRON_SECRET=...`), and in Vault as 'cron_secret'.
CRON_SECRET=

# ---- IP fraud/VPN detection (optional — powers the "No VPN" offer tag; a
# trade on a no_vpn-tagged offer simply skips the check and lets any IP
# through until this is set, since a misconfigured or down provider should
# never block a real trade).
# Free tier: https://www.ipqualityscore.com/create-account (5,000 lookups/month).
IPQUALITYSCORE_API_KEY=
